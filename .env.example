# Configuration SMTP pour l'envoi d'emails (Alertes, rapports)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=votre_email@example.com
SMTP_PASSWORD=votre_mot_de_passe_ou_app_password
SMTP_FROM=ne-pas-repondre@example.com
SMTP_NAME="Inventaire Pompier"
SMTP_USE_TLS=true

# Clé de sécurité pour l'accès via QR Code (ex: verifier.php?cle=VOTRE_CLE)
CLE_SECRETE_ACCES=mot_de_passe_secret_1234
